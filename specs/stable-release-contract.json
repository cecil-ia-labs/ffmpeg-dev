{
  "schemaVersion": 1,
  "release": "1.2.0",
  "package": {
    "name": "@cecilialabs/ffmpeg",
    "binary": "cecilia-ffmpeg",
    "export": ".",
    "node": ">=22.0.0",
    "license": "MIT",
    "access": "public",
    "mcpBinary": "cecilia-ffmpeg-mcp",
    "mcpExport": "./mcp"
  },
  "plugin": {
    "name": "ffmpeg-media-toolkit"
  },
  "mediaEngine": {
    "ffmpegMinimum": "6.1",
    "ffprobeRequired": true
  },
  "cli": {
    "globalOptions": [
      "output",
      "overwrite",
      "dry-run",
      "json",
      "quiet",
      "verbose",
      "no-progress",
      "no-color",
      "ffmpeg-path",
      "ffprobe-path",
      "keep-temp"
    ],
    "topLevelCommands": [
      "doctor",
      "probe",
      "environment",
      "video",
      "audio",
      "convert",
      "compose",
      "diagnose",
      "repair",
      "stream",
      "image"
    ]
  },
  "compatibility": {
    "historicalBashMigrations": 21,
    "runtimeShellDependency": false
  },
  "skills": [
    "ffmpeg-environment",
    "ffmpeg-video-editing",
    "ffmpeg-audio",
    "ffmpeg-conversion",
    "ffmpeg-composition",
    "ffmpeg-streaming",
    "ffmpeg-diagnostics"
  ],
  "mcp": {
    "protocol": "2026-07-28",
    "sdk": "@modelcontextprotocol/server@^2.0.0",
    "transport": "stdio",
    "tools": [
      "media_probe",
      "media_trim",
      "media_convert",
      "media_concat",
      "media_attach_audio",
      "media_remove_silence",
      "media_generate_silence",
      "media_restore",
      "media_diagnose"
    ]
  },
  "hardwareAcceleration": {
    "default": "software",
    "modes": [
      "software",
      "auto",
      "nvenc",
      "qsv",
      "vaapi",
      "videotoolbox"
    ],
    "codecs": {
      "h264": {
        "software": "libx264",
        "nvenc": "h264_nvenc",
        "qsv": "h264_qsv",
        "vaapi": "h264_vaapi",
        "videotoolbox": "h264_videotoolbox"
      },
      "vp9": {
        "software": "libvpx-vp9",
        "qsv": "vp9_qsv",
        "vaapi": "vp9_vaapi"
      }
    },
    "runtimeProbe": true,
    "softwareFallback": true,
    "strictMode": true
  }
}
