{
  "schemaVersion": 1,
  "release": "2.0.0",
  "package": {
    "name": "@cecilialabs/ffmpeg",
    "binary": "cecilia-ffmpeg",
    "export": ".",
    "node": ">=22.0.0",
    "license": "MIT",
    "access": "public"
  },
  "plugin": {
    "name": "cecilialabs-ffmpeg"
  },
  "mediaEngine": {
    "ffmpegMinimum": "6.1",
    "ffprobeRequired": true
  },
  "cli": {
    "globalOptions": [
      "output",
      "overwrite",
      "dry-run",
      "json",
      "quiet",
      "verbose",
      "no-progress",
      "no-color",
      "ffmpeg-path",
      "ffprobe-path",
      "keep-temp"
    ],
    "topLevelCommands": [
      "pipeline",
      "doctor",
      "probe",
      "environment",
      "video",
      "audio",
      "convert",
      "compose",
      "diagnose",
      "repair",
      "stream",
      "image"
    ]
  },
  "compatibility": {
    "runtimeShellDependency": false
  },
  "skills": [
    "ffmpeg-environment",
    "ffmpeg-video-editing",
    "ffmpeg-audio",
    "ffmpeg-conversion",
    "ffmpeg-composition",
    "ffmpeg-streaming",
    "ffmpeg-diagnostics",
    "ffmpeg-pipelines",
    "ffmpeg-onboarding",
    "ffmpeg-workflow"
  ],
  "hardwareAcceleration": {
    "default": "software",
    "modes": [
      "software",
      "auto",
      "nvenc",
      "qsv",
      "vaapi",
      "videotoolbox"
    ],
    "codecs": {
      "h264": {
        "software": "libx264",
        "nvenc": "h264_nvenc",
        "qsv": "h264_qsv",
        "vaapi": "h264_vaapi",
        "videotoolbox": "h264_videotoolbox"
      },
      "vp9": {
        "software": "libvpx-vp9",
        "qsv": "vp9_qsv",
        "vaapi": "vp9_vaapi"
      }
    },
    "runtimeProbe": true,
    "softwareFallback": true,
    "strictMode": true
  },
  "pipeline": {
    "schemaVersion": 1,
    "cliCommand": "pipeline <file> <validate|print|run>",
    "parser": "js-yaml@^4.3.2",
    "steps": [
      "trim",
      "speed",
      "resize",
      "normalize",
      "audio.normalize",
      "convert",
      "preset"
    ],
    "presets": {
      "local": true,
      "nested": true,
      "cycleDetection": true
    },
    "relativePaths": "pipeline-file-directory",
    "intermediateWorkspace": true,
    "dryRun": true
  }
}
