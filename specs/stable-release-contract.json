{
  "schemaVersion": 1,
  "release": "1.0.0",
  "package": {
    "name": "@cecilialabs/ffmpeg",
    "binary": "cecilia-ffmpeg",
    "export": ".",
    "node": ">=22.0.0",
    "license": "MIT",
    "access": "public"
  },
  "plugin": {
    "name": "ffmpeg-media-toolkit"
  },
  "mediaEngine": {
    "ffmpegMinimum": "6.1",
    "ffprobeRequired": true
  },
  "cli": {
    "globalOptions": [
      "output",
      "overwrite",
      "dry-run",
      "json",
      "quiet",
      "verbose",
      "no-progress",
      "no-color",
      "ffmpeg-path",
      "ffprobe-path",
      "keep-temp"
    ],
    "topLevelCommands": [
      "doctor",
      "probe",
      "environment",
      "video",
      "audio",
      "convert",
      "compose",
      "diagnose",
      "repair",
      "stream",
      "image"
    ]
  },
  "compatibility": {
    "historicalBashMigrations": 21,
    "runtimeShellDependency": false
  },
  "skills": [
    "ffmpeg-environment",
    "ffmpeg-video-editing",
    "ffmpeg-audio",
    "ffmpeg-conversion",
    "ffmpeg-composition",
    "ffmpeg-streaming",
    "ffmpeg-diagnostics"
  ]
}
