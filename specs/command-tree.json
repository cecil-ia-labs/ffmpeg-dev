{
  "binary": "cecilia-ffmpeg",
  "globalOptions": [
    "output",
    "overwrite",
    "dry-run",
    "json",
    "quiet",
    "verbose",
    "no-progress",
    "no-color",
    "ffmpeg-path",
    "ffprobe-path",
    "keep-temp"
  ],
  "commands": {
    "run": {
      "args": [
        "pipeline"
      ]
    },
    "doctor": {},
    "probe": {
      "args": [
        "input"
      ]
    },
    "environment": {
      "subcommands": {
        "capabilities": {},
        "version": {},
        "check": {},
        "install": {
          "args": [
            "scope?"
          ]
        }
      }
    },
    "video": {
      "subcommands": {
        "trim-start": {
          "args": [
            "input"
          ]
        },
        "trim-end": {
          "args": [
            "input"
          ]
        },
        "trim": {
          "args": [
            "input"
          ]
        },
        "speed": {
          "args": [
            "input"
          ]
        },
        "from-image": {
          "args": [
            "input"
          ]
        },
        "restore": {
          "args": [
            "input"
          ]
        },
        "upscale": {
          "args": [
            "input"
          ]
        },
        "attach-audio": {
          "args": [
            "video",
            "audio"
          ]
        },
        "add-silence": {
          "args": [
            "video"
          ]
        }
      }
    },
    "audio": {
      "subcommands": {
        "attach": {
          "args": [
            "video",
            "audio"
          ]
        },
        "silence": {},
        "add-silence": {
          "args": [
            "video"
          ]
        },
        "detect-silence": {
          "args": [
            "input"
          ]
        },
        "remove-silence": {
          "args": [
            "input"
          ]
        },
        "telephony": {
          "args": [
            "input"
          ]
        }
      }
    },
    "convert": {
      "subcommands": {
        "file": {
          "args": [
            "input"
          ]
        },
        "batch": {
          "args": [
            "directory"
          ]
        }
      }
    },
    "compose": {
      "subcommands": {
        "concat": {
          "args": [
            "inputs..."
          ]
        },
        "transition": {
          "args": [
            "left",
            "right"
          ]
        },
        "slideshow": {
          "args": [
            "directory"
          ]
        }
      }
    },
    "diagnose": {
      "args": [
        "input"
      ]
    },
    "repair": {
      "subcommands": {
        "timestamps": {
          "args": [
            "input"
          ]
        },
        "normalize": {
          "args": [
            "input"
          ]
        }
      }
    },
    "stream": {
      "subcommands": {
        "camera": {},
        "file": {
          "args": [
            "input"
          ]
        }
      }
    },
    "image": {
      "subcommands": {
        "convert": {
          "args": [
            "input"
          ]
        },
        "extract": {
          "args": [
            "input"
          ]
        }
      }
    }
  }
}
