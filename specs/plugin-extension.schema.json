{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cecilialabs.com/schemas/ffmpeg-media-toolkit/plugin-extension.schema.json",
  "title": "Cecil-IA Labs FFmpeg Media Toolkit Plugin Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["branding", "documentation", "skillCatalog", "npm"],
  "properties": {
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "icon", "iconDark", "logo", "screenshots"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "pattern": "^\\./" },
        "iconDark": { "type": "string", "pattern": "^\\./" },
        "logo": { "type": "string", "pattern": "^\\./" },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^\\./" }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme", "skills", "packaging"],
      "properties": {
        "readme": { "type": "string", "pattern": "^\\./" },
        "skills": { "type": "string", "pattern": "^\\./" },
        "packaging": { "type": "string", "pattern": "^\\./" }
      }
    },
    "skillCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^\\./skills/.+/SKILL\\.md$" }
        }
      }
    },
    "npm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "binary"],
      "properties": {
        "package": { "const": "@cecilialabs/ffmpeg" },
        "binary": { "const": "cecilia-ffmpeg" }
      }
    }
  }
}
