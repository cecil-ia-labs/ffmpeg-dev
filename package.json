{
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "author": "Cecil-IA Labs",
  "bin": {
    "cecilia-ffmpeg": "./dist/cli.js",
    "cecilia-ffmpeg-mcp": "./dist/mcp.js"
  },
  "bugs": {
    "url": "https://github.com/cecil-ia-labs/ffmpeg-dev/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "description": "Agent-friendly FFmpeg toolkit with CLI, MCP tools, and typed hardware acceleration.",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "specs/",
    "docs/",
    "plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/cecil-ia-labs/ffmpeg-dev",
  "keywords": [
    "ffmpeg",
    "ffprobe",
    "video",
    "audio",
    "media",
    "cli",
    "typescript",
    "automation",
    "agents",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@cecilialabs/ffmpeg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecil-ia-labs/ffmpeg-dev.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "codex:cleanup": "node scripts/codex-environment-cleanup.mjs",
    "codex:setup": "node scripts/codex-environment-setup.mjs",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "fixtures:clean": "node scripts/clean-fixtures.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "link:cli": "npm run build && npm link",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate:release",
    "setup:cli": "node scripts/setup-local-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "unlink:cli": "npm unlink --global @cecilialabs/ffmpeg",
    "validate": "npm run verify:foundation && npm run verify:runtime && npm run verify:inspection && npm run verify:video && npm run verify:audio && npm run verify:conversion && npm run verify:composition && npm run verify:diagnostics && npm run verify:streaming && npm run verify:skills && npm run verify:plugin && npm run verify:test-suite && npm run verify:fixtures && npm run verify:ux && npm run verify:media-expansion && npm run verify:docs && npm run verify:distribution && npm run verify:mcp && npm run verify:hardware && npm run check && npm run lint && npm run test && npm run build && npm run verify:package",
    "verify:audio": "node scripts/verify-audio.mjs",
    "verify:composition": "node scripts/verify-composition.mjs",
    "verify:conversion": "node scripts/verify-conversion.mjs",
    "verify:diagnostics": "node scripts/verify-diagnostics.mjs",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:inspection": "node scripts/verify-inspection.mjs",
    "verify:media-expansion": "node scripts/verify-media-expansion.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:streaming": "node scripts/verify-streaming.mjs",
    "verify:test-suite": "node scripts/verify-test-suite.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:video": "node scripts/verify-video.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "validate:release": "npm run validate && npm run verify:release && npm run verify:install",
    "verify:install": "npm run build && node scripts/verify-install.mjs",
    "smoke:platform": "node scripts/smoke-platform.mjs",
    "mcp": "tsx src/mcp.ts",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:hardware": "node scripts/verify-hardware.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  }
}
