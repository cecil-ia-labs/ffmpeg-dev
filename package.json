{
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "author": "Cecil-IA Labs",
  "bin": {
    "cecilia-ffmpeg": "./dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/cecil-ia-labs/ffmpeg-dev/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.2.0",
    "js-yaml": "^4.3.2"
  },
  "description": "Agent-friendly FFmpeg toolkit with CLI, Skills, scripts, hardware acceleration, and declarative pipelines.",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "specs/",
    "docs/",
    "plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/cecil-ia-labs/ffmpeg-dev",
  "keywords": [
    "ffmpeg",
    "ffprobe",
    "video",
    "audio",
    "media",
    "cli",
    "typescript",
    "automation",
    "agents"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@cecilialabs/ffmpeg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecil-ia-labs/ffmpeg-dev.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/prepare-binaries.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "codex:cleanup": "node scripts/codex-environment-cleanup.mjs",
    "codex:setup": "node scripts/codex-environment-setup.mjs",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "fixtures:clean": "node scripts/clean-fixtures.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "link:cli": "npm run build && npm link",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate:release",
    "setup:cli": "node scripts/setup-local-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "unlink:cli": "npm unlink --global @cecilialabs/ffmpeg",
    "validate": "npm run verify:foundation && npm run verify:runtime && npm run verify:inspection && npm run verify:video && npm run verify:audio && npm run verify:conversion && npm run verify:composition && npm run verify:diagnostics && npm run verify:streaming && npm run verify:cli-surface && npm run verify:skills && npm run verify:skill-scripts && npm run verify:agent-workflows && npm run verify:environment-flow && npm run verify:plugin && npm run verify:test-suite && npm run verify:fixtures && npm run verify:ux && npm run verify:media-expansion && npm run verify:docs && npm run verify:distribution && npm run verify:hardware && npm run verify:output-preflight && npm run verify:pipeline && npm run check && npm run lint && npm run test && npm run build && npm run verify:package",
    "verify:audio": "node scripts/verify-audio.mjs",
    "verify:agent-workflows": "node scripts/verify-agent-workflows.mjs",
    "verify:cli-surface": "node scripts/verify-cli-surface.mjs",
    "verify:composition": "node scripts/verify-composition.mjs",
    "verify:conversion": "node scripts/verify-conversion.mjs",
    "verify:diagnostics": "node scripts/verify-diagnostics.mjs",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:inspection": "node scripts/verify-inspection.mjs",
    "verify:media-expansion": "node scripts/verify-media-expansion.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:skill-scripts": "node scripts/verify-skill-scripts.mjs",
    "verify:environment-flow": "node scripts/verify-environment-flow.mjs",
    "verify:streaming": "node scripts/verify-streaming.mjs",
    "verify:test-suite": "node scripts/verify-test-suite.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:video": "node scripts/verify-video.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "validate:release": "npm run validate && npm run verify:release && npm run verify:install",
    "verify:install": "npm run build && node scripts/verify-install.mjs",
    "smoke:platform": "node scripts/smoke-platform.mjs",
    "verify:hardware": "node scripts/verify-hardware.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs",
    "verify:output-preflight": "node scripts/verify-output-preflight.mjs",
    "pack:openai-plugin": "bash scripts/pack-openai-plugin.sh"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  }
}
